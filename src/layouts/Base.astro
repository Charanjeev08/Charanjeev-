---
import '@fontsource-variable/inter';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { SITE } from '../lib/site';
import { graph, webPageSchema } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = SITE.defaultDescription, noindex = false } = Astro.props;
// Canonical uses the path only, so query parameters never create duplicates.
const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(/\/$/, '') || SITE.url;
const jsonLd = graph(webPageSchema({ url: canonical, title, description }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="logo">{SITE.name}</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {SITE.personName}</p>
    </footer>
  </body>
</html>

<style is:global>
  /* Metric-matched fallback so text does not shift when Inter loads. */
  @font-face {
    font-family: 'Inter Fallback';
    src: local('Arial');
    size-adjust: 107%;
    ascent-override: 90%;
    descent-override: 22%;
    line-gap-override: 0%;
  }
  :root {
    --font: 'Inter Variable', 'Inter Fallback', system-ui, sans-serif;
    --text: #111;
    --muted: #555;
    --bg: #fff;
    --border: #e5e5e5;
    --max: 72rem;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 1rem; top: 1rem; background: #fff; padding: .5rem 1rem; }
  .site-header, .site-footer {
    max-width: var(--max);
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem 1rem;
  }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: .9rem; }
  .logo { font-weight: 700; color: var(--text); text-decoration: none; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
